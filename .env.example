# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Public URL of the app (no trailing slash). Its host must match the Strava "Authorization Callback Domain".
BASE_URL=http://localhost:8000
# Random string for signing session cookies: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
